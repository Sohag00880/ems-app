# Mobile app environment variables.
# In Expo, only variables prefixed with EXPO_PUBLIC_ are exposed to the app.
# Copy this file to `.env` and fill in real values locally. Never commit `.env`.
#
# IMPORTANT for physical Android devices: localhost refers to the phone, not your PC.
# Use your PC's LAN IP (e.g. http://192.168.1.23:4000) and allow Node.js through
# Windows Firewall on port 4000.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000